<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.PlotCoordinateSet"
             Title="Plot Setup">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="Current Plot Center" 
               FontSize="24" 
               HorizontalOptions="Center" />

        <Label x:Name="CoordinatesLabel" 
             Text="Not Set" 
             FontSize="28" 
             FontAttributes="Bold"
             TextColor="DarkGreen"
             HorizontalOptions="Center" />

        <Label x:Name="StatusLabel" 
               Text="Press button to acquire GPS lock." 
               FontSize="14" 
               TextColor="Gray"
               HorizontalOptions="Center" 
               HorizontalTextAlignment="Center" />

        <Button x:Name="LockCenterButton"
                Text="Lock Plot Center" 
                Clicked="OnLockCenterClicked" 
                BackgroundColor="#2B5B84" 
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="15" />

        <Button x:Name="LogTreeButton"
                Text="Log Tree"
                Clicked="OnLogTreeClicked"
                Margin="0, 30, 0, 0" />

    </VerticalStackLayout>
</ContentPage>