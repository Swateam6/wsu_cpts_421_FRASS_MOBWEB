<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.PlotCoordinateSet"
             Title="Plot Setup">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="Select Target Plot" 
               FontSize="24" 
               HorizontalOptions="Center" />

        <Picker x:Name="PlotPicker"
                Title="Tap to select a plot..."
                SelectedIndexChanged="OnPlotSelected"
                HorizontalOptions="FillAndExpand" />

        <Label x:Name="CoordinatesLabel" 
             Text="Coordinates: Not Set" 
             FontSize="18" 
             FontAttributes="Bold"
             TextColor="DarkGreen"
             HorizontalOptions="Center" />

        <Label x:Name="StatusLabel" 
               Text="Please select a plot from the database." 
               FontSize="14" 
               TextColor="Gray"
               HorizontalOptions="Center" 
               HorizontalTextAlignment="Center" />

        <Button x:Name="LogTreeButton"
                Text="Log Tree"
                Clicked="OnLogTreeClicked"
                Margin="0, 30, 0, 0" 
                IsEnabled="False" />
    </VerticalStackLayout>
</ContentPage>