<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.PlotCoordinateSet"
             Title="Plot Setup">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="FillAndExpand">

        <Label Text="Select Target Plot" 
               FontSize="24" 
               HorizontalOptions="Center" />

        <Border Stroke="#2B5B84" StrokeThickness="2" BackgroundColor="#F8F9FA" Padding="5" HeightRequest="300">
            <CollectionView x:Name="PlotList"
                            SelectionMode="Single"
                            SelectionChanged="OnPlotSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="15">
                            <Label Text="{Binding .}" FontSize="16" TextColor="Black" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <Label x:Name="CoordinatesLabel" 
             Text="Coordinates: Not Set" 
             FontSize="18" 
             FontAttributes="Bold"
             TextColor="DarkGreen"
             HorizontalOptions="Center" />

        <Label x:Name="StatusLabel" 
               Text="Please select a plot from the list above." 
               FontSize="14" 
               TextColor="Gray"
               HorizontalOptions="Center" 
               HorizontalTextAlignment="Center" />

        <Button x:Name="GoTothePlotCenter"
                Text="Select Plot For Navigation"
                Clicked="OntoPlotNavClicked"
                Margin="0, 10, 0, 0" 
                IsEnabled="False" />
    </VerticalStackLayout>
</ContentPage>