<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.DatabaseTestScreen"
             Title="Database Test">
        <ScrollView>
                <VerticalStackLayout Spacing="15"
                                Padding="20">

                        <Label Text="Database Test Suite"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                        <Button Text="Populate Database"
                                Clicked="OnPopulateDatabaseClicked"
                                HorizontalOptions="Fill"/>

                        <Button Text="Print Database Contents"
                                Clicked="OnPrintContentsClicked"
                                HorizontalOptions="Fill"/>
                        <Button Text="Seed 78 Kamiak Plots"
                                Clicked="OnSeedKamiakPlotsClicked"
                                BackgroundColor="DarkGreen"
                                TextColor="White"
                                HorizontalOptions="Fill"/>
                        <Button Text="Clear Database"
                                Clicked="OnClearDatabaseClicked"
                                HorizontalOptions="Fill"/>

                        <Border BackgroundColor="AliceBlue"
                                        HeightRequest="350">
                                <ScrollView>
                                        <Label x:Name="OutputLabel"
                                               Text="Output will appear here..."
                                               FontSize="12"
                                               FontFamily="Courier"
                                               LineBreakMode="WordWrap"/>
                                </ScrollView>
                        </Border>

                        <Button Text="Back to Home"
                                Clicked="OnBackClicked"
                                HorizontalOptions="Fill"/>

                </VerticalStackLayout>
        </ScrollView>
</ContentPage>