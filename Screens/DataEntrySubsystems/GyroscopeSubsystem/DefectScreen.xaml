<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.DataEntrySubsystems.GyroscopeSubsystem.DefectScreen"
             Title="Defect Measurement">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="Measure Defect"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />

            <Border Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="CurrentAngleLabel"
                           Text="Gyroscope: Stopped"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <Label x:Name="DefectBaseLabel"
                           Text="Defect Base: ---"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />

                    <Label x:Name="DefectTopLabel"
                           Text="Defect Top: ---"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Entry x:Name="DistanceEntry"
                   Placeholder="Distance (ft)"
                   Keyboard="Numeric" />

            <Entry x:Name="DefectDescriptionEntry"
                   Placeholder="Defect Description" />

            <Label x:Name="StatusMessageLabel"
                   Text=""
                   TextColor="{StaticResource MidnightBlue}"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Margin="0,5" />

            <Button Text="1. Start Sensor"
                    Clicked="OnGyroMeasureClicked" />

            <Button Text="2. Zero Gyro"
                    Clicked="OnZeroClicked"
                    BackgroundColor="{StaticResource Gray500}" />

            <Button Text="3. Capture Base"
                    Clicked="OnCaptureBaseClicked"
                    BackgroundColor="{StaticResource MidnightBlue}" />

            <Button Text="4. Capture Top"
                    Clicked="OnCaptureTopClicked"
                    BackgroundColor="{StaticResource MidnightBlue}" />

            <Button Text="5. Save Defect"
                    Clicked="OnSaveDefectClicked"
                    BackgroundColor="{StaticResource Magenta}" />

            <Button Text="Return"
                    Clicked="OnReturnClicked"
                    Margin="0,10,0,0" />

            <Button Text="Next Tree"
                    Clicked="OnNextTreeClicked"
                    Margin="0,30,0,0" />

            <Button Text="Finish Stand"
                    Clicked="OnFinishStandClicked"
                    BackgroundColor="{StaticResource Gray500}" />

            <Button Text="Finish Plot"
                    Clicked="OnFinishPlotClicked"
                    BackgroundColor="{StaticResource MidnightBlue}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>