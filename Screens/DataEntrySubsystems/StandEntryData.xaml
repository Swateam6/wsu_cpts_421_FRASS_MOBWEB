<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.DataEntrySubsystems.StandEntryData"
             Title="Stand Initialization"
             BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource MidnightBlue}}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="FRASS - New Stand" 
                   FontSize="24" 
                   FontFamily="OpenSansRegular"
                   TextColor="{StaticResource Primary}"
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"/>

            <Label Text="Total Acres:" 
                   FontFamily="OpenSansRegular"
                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource Secondary}}"
                   FontAttributes="Bold" />
            <Entry x:Name="AcresEntry" 
                   Placeholder="0.0" 
                   Keyboard="Numeric" 
                   FontFamily="OpenSansRegular"
                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark=White}"
                   ClearButtonVisibility="WhileEditing" />

            <Label Text="Measurement Method:" 
                   FontFamily="OpenSansRegular"
                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource Secondary}}"
                   FontAttributes="Bold" />
            <Picker x:Name="PlotTypePicker" 
                    Title="Select Method..." 
                    SelectedIndexChanged="OnPlotTypeSelectedIndexChanged"
                    BackgroundColor="White"
                    TextColor="Black">
                <Picker.Items>
                    <x:String>Variable Radius (Prism)</x:String>
                    <x:String>Fixed Radius</x:String>
                </Picker.Items>
            </Picker>

            <VerticalStackLayout x:Name="VariableSection" IsVisible="False" Spacing="10">
                <Label Text="Basal Area Factor (BAF):" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#2B5B84" />
                <Picker x:Name="BafPicker" 
                        Title="Select Prism BAF..." 
                        BackgroundColor="White"
                        TextColor="Black">
                    <Picker.Items>
                        <x:String>10</x:String>
                        <x:String>20</x:String>
                        <x:String>30</x:String>
                        <x:String>40</x:String>
                        <x:String>60</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="FixedSection" IsVisible="False" Spacing="10">
                <Label Text="Plot Radius (Feet):" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#2B5B84" />
                <Entry x:Name="RadiusEntry" 
                       Placeholder="e.g. 37.2 for 1/10th acre" 
                       Keyboard="Numeric" 
                       BackgroundColor="White"
                       TextColor="Black" />
            </VerticalStackLayout>

            <Button Text="Start Plotting" 
                    Clicked="OnStartPlottingClicked" 
                    Margin="0,20,0,0"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontFamily="OpenSansRegular"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="8"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>