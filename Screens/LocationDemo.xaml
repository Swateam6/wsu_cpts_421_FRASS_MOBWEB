<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.LocationDemo"
             Title="LocationDemo">
    <ContentPage.BindingContext>
        <local:LocationDisplayBackend xmlns:local="clr-namespace:MOBWEB_TEST.Location" />
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label 
            Text="Location Demo"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button
            x:Name="GetLocation"
            Text="{Binding ListeningButtonText}"
            Command="{Binding ChangeListeningModeCommand}"
            HorizontalOptions="Fill" />
        
        <!--User Location -->
        <Grid ColumnSpacing="10" RowSpacing="10" IsVisible="{Binding IsListening}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="User Position"
                   TextColor="Black"
                   BackgroundColor="LightGray"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold" />
            <Label Grid.Row="1" Grid.Column="0" Text="Latitude" TextColor="Black" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Latitude}" TextColor="Black" />
            <Label Grid.Row="2" Grid.Column="0" Text="Longitude" TextColor="Black" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Longitude}" TextColor="Black" />
            <Label Grid.Row="3" Grid.Column="0" Text="Altitude(m)" TextColor="Black" />
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Altitude}" TextColor="Black" />
        </Grid>
        
        <!--Compass-->
        <VerticalStackLayout IsVisible="{Binding IsListening}" Spacing="10" Padding="10">
            <Label Text="Compass"
                   TextColor="Black"
                   BackgroundColor="LightGray"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"
                   Padding="5" />

            <!-- Cardinal Direction Display -->
            <Label x:Name="CardinalDirectionLabel"
                   Text="{Binding Reading, StringFormat='Heading: {0:F1}°'}"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   FontSize="16" />

            <!-- Cardinal/Ordinal Direction Text -->
            <Label x:Name="DirectionTextLabel"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   FontSize="24"
                   FontAttributes="Bold" />

            <!-- Rotating Compass Visual -->
            <Frame BorderColor="Gray"
                   CornerRadius="100"
                   Padding="10"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HasShadow="True">
                <Grid WidthRequest="200" HeightRequest="200">
                    <!-- Compass Circle Background -->
                    <BoxView BackgroundColor="White"
                        CornerRadius="100"
                        Grid.Row="0" />

                    <!-- Cardinal Direction Labels -->
                    <Label Text="N"
                            TextColor="Red"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Start"
                            Margin="0,10,0,0" />
                    <Label Text="S"
                            TextColor="Black"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="End"
                            Margin="0,0,0,10" />
                    <Label Text="E"
                            TextColor="Black"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,10,0" />
                    <Label Text="W"
                            TextColor="Black"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Margin="10,0,0,0" />

                    <!-- Rotating Compass Needle -->
                    <Grid x:Name="compassNeedle"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           WidthRequest="200"
                           HeightRequest="200">
                        <BoxView BackgroundColor="Red"
                              WidthRequest="4"
                              HeightRequest="70"
                              CornerRadius="2"
                              HorizontalOptions="Center"
                              VerticalOptions="Start"
                              Margin="0,10,0,0" />
                    </Grid>

                    <!-- Center Circle -->
                    <Ellipse Fill="Black"
                            WidthRequest="10"
                            HeightRequest="10"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                </Grid>
            </Frame>
        </VerticalStackLayout>
        <Border BackgroundColor="AliceBlue">
            <ScrollView>
                <Label x:Name="OutputLabel" 
               Text="Output will appear here..."
               FontSize="12"
               FontFamily="Courier"
               LineBreakMode="WordWrap" />
            </ScrollView>
        </Border>
        <Button Text="Navigate To Plot Centers" 
        Clicked="OnPrintContentsClicked"
        HorizontalOptions="Fill" />
        <Button
            x:Name="BackToHome"
            Text="Return to Home Screen"
            SemanticProperties.Hint="Keeps You Logged In"
            Clicked="OnBackToHomeClicked"
            HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>