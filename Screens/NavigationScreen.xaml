<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOBWEB_TEST.Screens.NavigationScreen"
             Title="Plot Navigation">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="Distance to Plot" 
               FontSize="24" 
               HorizontalOptions="Center" />

        <Label x:Name="DistanceLabel" 
               Text="-- ft" 
               FontSize="64" 
               FontAttributes="Bold"
               TextColor="DarkGreen"
               HorizontalOptions="Center" />

        <Label x:Name="StatusLabel" 
               Text="Waiting for Plot Center..." 
               FontSize="14" 
               TextColor="Gray"
               HorizontalOptions="Center" 
               HorizontalTextAlignment="Center" />

        <Button x:Name="TrackButton"
        Text="Start Tracking Distance" 
        Clicked="OnToggleTrackingClicked" 
        BackgroundColor="#2B5B84" 
        TextColor="White"
        FontAttributes="Bold"
        CornerRadius="8"
        Padding="15" />
    </VerticalStackLayout>
</ContentPage>