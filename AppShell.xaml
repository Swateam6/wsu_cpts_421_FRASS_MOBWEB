<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MOBWEB_TEST.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MOBWEB_TEST"
    Title="MOBWEB_TEST"
    FlyoutBehavior="Flyout">
    <ShellContent
        Title="Entry"
        ContentTemplate="{DataTemplate local:Screens.EntryScreen}"
        Route="EntryScreen" />

    <ShellContent 
        Title="Home"
        ContentTemplate="{DataTemplate local:Screens.HomeScreen}"
        Route="HomeScreen" />

    <ShellContent
        Title="Data Entry"
        ContentTemplate="{DataTemplate local:Screens.DataEntryScreen}"
        Route="DataEntryScreen" />

    <ShellContent
        Title="Profile"
        ContentTemplate="{DataTemplate local:Screens.ProfileScreen}"
        Route="ProfileScreen" />

    <ShellContent
        Title="Upload"
        ContentTemplate="{DataTemplate local:Screens.DataUploadScreen}"
        Route="DataUploadScreen" />

    <ShellContent

        Title="Database"
        ContentTemplate="{DataTemplate local:Screens.DatabaseTestScreen}"
        Route="DatabaseTestScreen" />
    <ShellContent
         Title="GeolocationDemo"
         Route="LocationDemo"
         ContentTemplate="{DataTemplate local:Screens.LocationDemo}" />

</Shell>

       

